%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3361a382e578a7249bb4b2e11cc91d36, type: 3}
  m_Name: GenZTestSuitConfig
  m_EditorClassIdentifier: 
  configVersion: 10
  sdkScene: {fileID: 102900000, guid: 6f17c457ec077674d80d38ade5f31c13, type: 3}
  adsObjectName: Ads
  googleSheetUrl: https://docs.google.com/spreadsheets/d/1nd87c3FFAHqOhtNIN2ZqVyXlNlSfsQJo2YjL1wh9UMk/edit?gid=0#gid=0
  sheetTabs:
  - name: Android Games ID's
    gid: 0
  - name: Android Max ID's
    gid: 1078150226
  verifyAgainstSheet: 1
  packageColumnNames:
  - Package Name
  - Package
  - Bundle ID
  - Bundle Identifier
  - Application ID
  runIdChecks: 1
  runIntegrationChecks: 1
  integration:
    requiredSdks:
    - Firebase|Firebase
    - GameAnalytics|GameAnalytics
    - AppMetrica|AppMetrica
    - Adjust|Adjust
    - AppLovin MAX|MaxSdk
    - Google Mobile Ads|GoogleMobileAds
    firebaseModules:
    - Firebase.App
    - Firebase.Analytics
    - Firebase.RemoteConfig
  playerSettings:
    enabled: 1
    autoGraphicsApi: 0
    forbiddenGraphicsApis:
    - Vulkan
    requireES31: 0
    requireES31AEP: 1
    requireES32: 1
    scriptingBackend: IL2CPP
    targetArchitectures:
    - ARMv7
    - ARM64
    minSdk: 24
    targetSdk: 36
  taichi:
    enabled: 1
    managerClasses:
    - FirebaseManager
    requireTaichi1: 0
    requireTaichi2: 1
    taichi1Flags:
    - Taiche1_0
    - Taichi1_0
    - taichi1
    - Taichi1
    taichi2Flags:
    - Taiche2_0
    - Taichi2_0
    - taichi2
    - Taichi2
    taichi1Event: custom_ad_impression
    taichi2Event: count_ad_impression
    taichi1Key: custom_rev
    taichi2Key: custom_imp
    defaultClasses:
    - RemoteConfigManager
    taichi1DefaultFields:
    - taichi1DefaultRevenue
    taichi2DefaultFields:
    - taichi2DefaultImpressions
    taichi2SheetColumns:
    - Taichi 2.0 Default Values
    - Taichi 2.0 Default
    - Taichi Default Values
    - Taichi 2.0
  codeChecks:
    enabled: 1
    adScripts:
    - AdMob
    - Admob
    - AdsIds
    - AdsManager
    - Analytics
    - AppmetricaAnalytics
    - AppOpen_Code
    - BigBanner
    - FirebaseManager
    - GA_Aanalytics
    - InAppCalling
    - InAppReviewManager
    - UmpManager
    - unityInApp
    requiredScripts:
    - AdMob|Admob
    - AdsIds
    - AdsManager
    - Analytics
    - AppmetricaAnalytics
    - AppOpen_Code
    - FirebaseManager
    - GA_Aanalytics
    - InAppCalling
    - InAppReviewManager
    - UmpManager
    - unityInApp
    - AdsGapTimer
    gapTimerClass: AdsGapTimer
    resetMethods:
    - ResetTimer
    timerFields:
    - timeLeft
    gateFields:
    - canShowAd
    remoteConfigClasses:
    - FirebaseManager
    - RemoteConfigManager
    vendorSwitchFields:
    - useSdkVendorSwitch
    revenueSinks:
    - Adjust|\bAdjust\s*\.\s*TrackAdRevenue\s*\(
    - Firebase|"ad_impression"|\bEventAdImpression\b
    - AppMetrica|\bReportRevenue_\w*\s*\(|\bReportAdRevenue\s*\(
    excludeFolders:
    - Plugins
    - GoogleMobileAds
    - MaxSdk
    - Firebase
    - GameAnalytics
    - Adjust
    - AppMetrica
    - ExternalDependencyManager
    - Dreamteck
    - Demigiant
    - NiceVibrations
    - TextMesh Pro
    - Kits
  apk:
    requiredSdks:
    - MAX
    - AdMob
    - Firebase
    - RemoteConfig
    - GameAnalytics
    - Adjust
    - AppMetrica
    - UMP
    optionalSdks:
    - IAP
    - FCM
    firebaseEvents:
    - ad_impression
    adFormats:
    - Banner
    - Interstitial
    - Rewarded
    - AppOpen
    requiredPermissions:
    - android.permission.INTERNET
    - android.permission.ACCESS_NETWORK_STATE
    - com.google.android.gms.permission.AD_ID
    minTargetSdk: 36
    logcatBufferMb: 16
    firebaseEventPattern: 'Logging event(?: \(FE\))?:?\s*(?:origin=\w+,\s*name=)?([A-Za-z0-9_]+)'
    firebaseUploadOkPattern: 'Successful upload|Upload successful|network response\.
      code, size: 20\d'
    firebaseUploadFailPattern: 'Network upload failed|Upload failed|network response\.
      code, size: [45]\d\d'
    gaTag: GameAnalytics
    gaEventPattern: (?i)\b(add(ed|ing)?|sen[dt](ing)?)\b.*\bevents?\b
    gaErrorPattern: (?i)\b(error|fail(ed|ure)?|invalid)\b
    gaBuildPattern: '"build"\s*:\s*"([^"]+)"'
    adjustTag: Adjust
  deepTest:
    define: GENZ_DEEP_TEST
    maxVerboseLogging: 1
    maxCreativeDebugger: 1
    admobTestDevice: 1
    shakeThreshold: 2
    settings:
    - enabled: 1
      label: Adjust environment
      rule: Adjust
      fieldNames:
      - environment
      testValue: Sandbox
      releaseValue: Production
      note: 'Sandbox: test installs and events show in Adjust''s Testing Console,
        not in the live numbers.'
    - enabled: 1
      label: Adjust log level
      rule: Adjust
      fieldNames:
      - logLevel
      testValue: Verbose
      releaseValue: Info
      note: Every Adjust request and response in logcat (tag Adjust).
    - enabled: 1
      label: AppMetrica logs
      rule: AppMetrica
      fieldNames:
      - Logs
      testValue: true
      releaseValue: false
      note: AppMetrica's own log in logcat (tag AppMetrica).
    - enabled: 1
      label: GameAnalytics verbose log
      rule: GameAnalytics Settings
      fieldNames:
      - VerboseLogBuild
      testValue: true
      releaseValue: false
      note: Every GameAnalytics event and its JSON in logcat.
    - enabled: 1
      label: GameAnalytics info log
      rule: GameAnalytics Settings
      fieldNames:
      - InfoLogBuild
      testValue: true
      releaseValue: true
      note: 'Kept on in release too: the APK Test Suit reads it.'
    - enabled: 0
      label: UMP consent test mode
      rule: UmpManager (AdMob consent)
      fieldNames:
      - isTestMode
      - testMode
      - isTestModeOn
      - debugMode
      testValue: true
      releaseValue: false
      note: 'Shows the EEA consent form on the test devices listed in UmpManager.
        Off by default: it only works on those devices.'
    actions:
    - name: Interstitial (game waterfall)
      load: 
      ready: 
      show: AdsManager.ShowInterstitial
      hide: 
      requireReady: 0
      before: 
      showFields: 
      rewardField: 
    - name: Rewarded (game waterfall)
      load: 
      ready: 
      show: AdsManager.ShowRewardedAd
      hide: 
      requireReady: 0
      before: 
      showFields: 
      rewardField: 
    - name: MAX Interstitial
      load: AdsManager.RequestInter
      ready: AdsManager.IsMaxInterstitialReady
      show: AdsManager.ShowMaxInterstitial
      hide: 
      requireReady: 1
      before: 
      showFields: 
      rewardField: 
    - name: MAX Rewarded
      load: AdsManager.RequestVideo
      ready: AdsManager.IsMaxRewardedReady
      show: AdsManager.ShowRewardedAd
      hide: 
      requireReady: 1
      before: 
      showFields: AdsManager.useSdkVendorSwitch=0
      rewardField: 
    - name: MAX Banner
      load: 
      ready: 
      show: AdsManager.ShowBanner
      hide: AdsManager.HideBanner
      requireReady: 0
      before: AdMob.bannerHide
      showFields: 
      rewardField: 
    - name: MAX MREC
      load: 
      ready: 
      show: AdsManager.ShowMRECBanner
      hide: AdsManager.HideMRECBanner
      requireReady: 0
      before: 
      showFields: 
      rewardField: 
    - name: AdMob Interstitial
      load: AdMob.RequestInterstitial
      ready: AdMob.HasAdmobInterstialAvaible
      show: AdMob.ShowInterstialAd
      hide: 
      requireReady: 1
      before: 
      showFields: 
      rewardField: 
    - name: AdMob Rewarded
      load: AdMob.RequesRewardAd
      ready: AdMob.HasRewardedAvaiable
      show: AdMob.ShowRewardAd
      hide: 
      requireReady: 1
      before: 
      showFields: 
      rewardField: AdsManager._rewarded
    - name: AdMob Banner
      load: AdMob.RequestBanner
      ready: 
      show: AdMob.bannerShow
      hide: AdMob.bannerHide
      requireReady: 0
      before: AdsManager.HideBanner
      showFields: AdsManager.isBannerShowing=false
      rewardField: 
    - name: AdMob App Open
      load: AppOpen_Code.LoadOpenApp
      ready: 
      show: AppOpen_Code.ShowAppOpenAdIfAvailable
      hide: 
      requireReady: 0
      before: 
      showFields: AdMob.isPausedDuetoAd=false
      rewardField: 
    watch:
    - AdsGapTimer.canShowAd
    - AdsGapTimer.time
    - AdsGapTimer.timeLeft
    - AdsManager.useSdkVendorSwitch
    - AdsManager.isBannerShowing
    - AdMob.isPausedDuetoAd
